{
  "name": "cookie-sentinel",
  "version": "1.1.1",
  "description": "Audit Set-Cookie headers for security issues: missing Secure/HttpOnly/SameSite, __Host-/__Secure- prefix violations, broad Domain/Path, long expiry, cookies over HTTP, oversized cookies, JWTs and emails in values, duplicates and Partitioned misuse, with a fix for each. Multi-page crawl with optional login, Open Cookie Database classification, optional Playwright/Puppeteer JS cookie capture. Follows redirects, supports auth headers and offline input. Text, JSON, SARIF, Markdown; GitHub Action included. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cookie-sentinel": "bin/cookie-sentinel.js"
  },
  "files": [
    "src",
    "dist",
    "data",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "update-ocdb": "node scripts/update-ocdb.mjs"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "puppeteer": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "cookies",
    "set-cookie",
    "security",
    "cookie-security",
    "samesite",
    "httponly",
    "secure-cookies",
    "web-security",
    "owasp",
    "sarif",
    "cli",
    "github-action",
    "devsecops",
    "audit",
    "csrf",
    "xss",
    "jwt",
    "open-cookie-database",
    "playwright",
    "puppeteer"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/cookie-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/cookie-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/cookie-sentinel/"
}
